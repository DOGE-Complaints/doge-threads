# =============================================================================
# doge-threads — example environment (local)
# Copy to `.env` (gitignored). Do not commit real secrets.
# Keys = REQ0 / `src/core/config/schema.py` only — no civic / NODE_SCHEMA_*.
# Alias ≠ folder: Builder Queue key `threads` → code root `doge-threads/`.
# =============================================================================

# --- Profile & persistence ---------------------------------------------------
# APP_PROFILE: demo | pilot (schema default: demo). pilot requires SERVICE_API_TOKEN.
APP_PROFILE=demo

# DB_BACKEND: in_memory | sqlite | supabase (schema default: in_memory).
# Local smoke / health without remote DB → in_memory.
DB_BACKEND=in_memory

# Supabase (only when DB_BACKEND=supabase). Leave empty for in_memory.
# Dashboard → Settings → API → Project URL / service_role key.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE=<service-role-key>
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL (default INFO)
LOG_LEVEL=INFO

# LOG_FORMAT: text | json (default text). Accepted by schema; used at configure_logging.
LOG_FORMAT=text

# Optional dir for per-story DEBUG files (accepted by AppConfig; file writers may be no-op).
LOG_DEBUG_DIR=

# --- Service auth & outbound peers (local ports from each service Makefile) ---
# Optional in demo. Required when APP_PROFILE=pilot.
# R7: threads outbound SERVICE_API_TOKEN for gateway calls = gateway inbound SERVICE_API_TOKEN.
SERVICE_API_TOKEN=

# Identity Me client — doge-identity-service local default PORT=8100
IDENTITY_BASE_URL=http://127.0.0.1:8100

# Civic gateway ThreadContext pull — doge-complaints-gateway local default PORT=8000
GATEWAY_BASE_URL=http://127.0.0.1:8000

# --- Node identity for ThreadKey (M1/S1; HTTP-01+) -----------------------------
# ThreadKey.node = DOGESTONIA_SCHEMA_ID only. VERSION is cross-service parity,
# not concatenated into node (S1). Empty VERSION at boot = Open U3.
# Do not use gateway NODE_SCHEMA_ID here.
DOGESTONIA_SCHEMA_ID=
DOGESTONIA_SCHEMA_VERSION=

# --- Bind port (make serve / make dev / railpack) -----------------------------
# Threads local default 8001 (gateway 8000, identity 8100 — no collision).
PORT=8001

# =============================================================================
# Persist profile (optional) — uncomment & fill; set DB_BACKEND=supabase above.
# Apply doge-threads/supabase/migrations/ on the shared node project first.
# =============================================================================
# DB_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE=<service-role-key>
